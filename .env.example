# Supabase project (Kapa Service Log)
SUPABASE_URL=https://wvayvybbinywglriunxm.supabase.co

# Supabase Dashboard -> Project Settings -> API Keys -> "service_role" / secret key.
# Server-only. Never prefix it with NEXT_PUBLIC_ and never paste it into client code.
SUPABASE_SECRET_KEY=

# Signs the sign-in cookie. Generate with: openssl rand -base64 32
APP_SESSION_SECRET=

# Time zone used for the "today" default on the date fields.
NEXT_PUBLIC_APP_TIME_ZONE=America/New_York

# Web push. Generate a fresh pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key is sent to the browser; the private one signs and stays server-side.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
